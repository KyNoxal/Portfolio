---
import Card from '../components/Card.astro';
import { 
  Phone, 
  Mail, 
  MapPin, 
  Car, 
  Smartphone, 
  Globe,
  ExternalLink 
} from 'lucide-astro';
import '../styles/global.css';
---

<html lang="fr">
<head>
    <meta charset="UTF-8" />
    <title>CV - Corentin Echivard--Lizaso</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><rect width=%22100%22 height=%22100%22 rx=%2220%22 fill=%22%23121212%22/><text x=%2250%%22 y=%2250%%22 dominant-baseline=%22central%22 text-anchor=%22middle%22 fill=%22%23cc9900%22 font-family=%22monospace%22 font-weight=%22bold%22 font-size=%2260%22>C</text></svg>">  </head>
<style is:global>
    .a4-container {
        width: 210mm;
        min-height: 297mm;
        margin: 20px auto;
        background-color: #121212;
        color: #e5e5e5;
        padding: 8mm;
        box-shadow: 0 0 20px rgba(0,0,0,0.5);
        display: flex;
        flex-direction: column;
    }

    @media print {
        @page {
            size: A4;
            margin: 0;
        }

        html, body {
            background-color: #ffffff !important;
            color: #1a1a1a !important;
            height: auto;
        }

        .a4-container {
            margin: 0;
            padding: 10mm;
            width: 210mm;
            height: 297mm;
            background-color: #ffffff !important;
            box-shadow: none;
            border: none !important;
        }

        .text-p-gold {
            color: #cc9900 !important; 
        }

        .text-p-gray-blue {
            color: #4b5563 !important;
        }

        .text-p-platinum {
            color: #1a1a1a !important;
        }

        .card-trigger {
            print-color-adjust: exact !important;
            -webkit-print-color-adjust: exact !important;
            
            background-color: #f3f4f6 !important; 
            border: 1px solid #e5e7eb !important;
            border-left: 3px solid #cc9900 !important;
            color: #1a1a1a !important;
            border-radius: 4px;
        }

        .bg-p-gray-blue\/20 {
            print-color-adjust: exact !important;
            -webkit-print-color-adjust: exact !important;
            background-color: #e5e7eb !important;
            height: 1px !important;
        }

        .no-print { display: none !important; }

        img {
            filter: none !important;
            print-color-adjust: exact;
            -webkit-print-color-adjust: exact;
        }

        a.group {
            print-color-adjust: exact !important;
            -webkit-print-color-adjust: exact !important;
            background-color: #f3f4f6 !important;
            border: 1px solid #e5e7eb !important;
            border-radius: 12px !important;
        }

        .bg-white {
            print-color-adjust: exact !important;
            -webkit-print-color-adjust: exact !important;
            background-color: #ffffff !important;
        }

        .text-p-gray-blue {
            color: #4b5563 !important;
        }
    }
</style>
</head>
<body class="bg-p-black text-p-platinum font-sans">

    <div class="no-print fixed bottom-8 right-8 z-50">
        <button onclick="window.print()" class="flex items-center gap-2 bg-p-gold text-p-black font-bold px-6 py-3 rounded-full shadow-2xl hover:scale-105 transition-all">
            <ExternalLink size={20} /> Enregistrer le CV (PDF)
        </button>
    </div>

    <div class="a4-container border border-p-gray-blue/10">
        
        <header class="flex justify-between items-start border-b-2 border-p-gold pb-2 mb-2">
            <div class="flex-1">
                <h1 class="text-3xl font-black uppercase tracking-tighter leading-none">
                    Corentin
                    <span class="text-p-gold">Echivard--Lizaso</span>
                </h1>
                <p class="text-p-gray-blue text-2xl mt-3 font-semibold">Futur ingénieur logiciel en alternance </p>
                <div class="mt-2 p-4 bg-p-black/30 border-l-4 border-p-gold rounded-r-lg max-w-2xl">
                    <p class="text-p-platinum/90 text-sm leading-relaxed italic">
                        "Futur ingénieur logiciel diplômé du Master ILSEN du CERI d'Avignon. À la recherche de mon premier poste en développement full-stack / ingénierie logicielle !"
                    </p>
                </div>
            </div>
            
            <div class="w-32 h-32 rounded-2xl border-2 border-p-gold overflow-hidden transition-transform duration-500 shadow-2xl">
                <img src="/Portfolio/images/6720840755940036346.jpeg" alt="Photo de Corentin ECHIVARD--LIZASO" class="w-full h-full object-cover" />
            </div>
        </header>

        <div class="grid grid-cols-12 gap-8 max-w-[650px]">
            
            <aside class="col-span-4 space-y-8 pr-2">
                
                <section class="space-y-4">
                    <h3 class="text-p-gold font-bold uppercase tracking-widest text-xs mb-4 flex items-center gap-2">
                        <Smartphone size={14} /> Coordonnées 
                    </h3>
                    <ul class="space-y-3 text-sm">
                        <li class="flex items-center gap-3 text-p-gray-blue">
                            <Phone size={16} class="text-p-gold" /> 06 07 33 93 40
                        </li>
                        <li class="text-p-gray-blue">
                            <div class="flex items-center gap-3">
                                <Mail size={16} class="text-p-gold flex-shrink-0" />
                                <p class="text-sm">corentin.echivardlizaso&#8203;@proton.me</p>
                            </div>
                        </li>
                        <li class="flex items-center gap-3 text-p-gray-blue">
                            <MapPin size={16} class="text-p-gold" /> Avignon / Bordeaux
                        </li>
                        <li class="flex items-center gap-3 text-p-gray-blue">
                            <Car size={16} class="text-p-gold" /> Mobile / Permis B
                        </li>
                    </ul>
                </section>

                <section class="space-y-6">
                    <h3 class="text-p-gold font-bold uppercase tracking-widest text-xs flex items-center gap-2">
                        <Globe size={14} /> Liens
                    </h3>
                    <div class="grid grid-cols-1 gap-4">
                        <a href="https://kynoxal.github.io/Portfolio/" target="_blank" class="flex items-center gap-4 p-3 bg-white/5 border border-p-gray-blue/20 rounded-xl hover:bg-p-gold/10 transition-colors group">
                            <div class="bg-white p-1 rounded-lg w-16 h-16 shrink-0">
                                <img src="/Portfolio/images/qr-codes/qr-code-portfolio.png" alt="QR Portfolio" class="w-full h-full" />
                            </div>
                            <div>
                                <p class="text-s font-bold text-p-gold uppercase tracking-tighter">Portfolio</p>
                                <p class="text-xs text-p-platinum">Apprenez en plus sur moi et mes projets !</p>
                            </div>
                        </a>
                        <a href="https://www.linkedin.com/in/corentin-echivard-lizaso-77480026b/" target="_blank" class="flex items-center gap-4 p-3 bg-white/5 border border-p-gray-blue/20 rounded-xl hover:bg-p-gold/10 transition-colors group">
                            <div class="bg-white p-1 rounded-lg w-16 h-16 shrink-0">
                                <img src="/Portfolio/images/qr-codes/qr-code-linkedIn.png" alt="QR LinkedIn" class="w-full h-full" />
                            </div>
                            <div>
                                <p class="text-xs font-bold text-p-gold uppercase tracking-tighter">LinkedIn</p>
                            </div>
                        </a>
                    </div>
                </section>

                <section class="space-y-4">
                   <h3 class="text-p-gold font-bold uppercase tracking-widest text-xs">Centres d'intérêts</h3>
                   <div class="space-y-2 overflow-hidden">
                       <Card title="Ferroviaire" variant="cv" />
                       <Card title="Musique" subtitle="Solfège et pratique instrumentale"  variant="cv" />
                   </div>
                </section>
                <section class="space-y-4">
                   <h3 class="text-p-gold font-bold uppercase tracking-widest text-xs">Compétences clés</h3>
                   <div class="space-y-2 overflow-hidden">
                       <Card title="Développement full-stack" variant="cv" />
                       <Card title="Base de données" variant="cv" />
                   </div>
                </section>
                <section class="space-y-4">
                   <h3 class="text-p-gold font-bold uppercase tracking-widest text-xs">Bénévolat</h3> 
                   <div class="space-y-2 overflow-hidden">
                       <Card title="BDE ETII" subtitle="Trésorier et bénévole" variant="cv" />
                       <Card title="Comité Fêtes" subtitle="Bénévole" variant="cv" />
                   </div>
                </section>
            </aside>

            <main class="col-span-8 min-w-130">
                <section class="gap-2 grid pb-2">
                    <h2 class="text-xl font-black flex items-center gap-4">
                        Formations <span class="h-px flex-1 bg-p-gray-blue/20"></span>
                    </h2>
                    <div class="grid grid-cols-2 gap-2">
                        <div class="max-w-[260px] overflow-hidden">
                            <Card 
                                title="Master ILSEN" 
                                subtitle="Univ. Avignon" 
                                uptext="2025 - 2027" 
                                description='Ingénierie du Logiciel de la SociétÉ Numérique (ILSEN)'
                                variant="cv" 
                            />
                        </div>
                        <div class="max-w-[260px] overflow-hidden">
                            <Card 
                                title="BUT Informatique" 
                                subtitle="IUT Dijon" 
                                description="Réalisation, conception, développement, validation"
                                uptext="2022 - 2025" 
                                variant="cv" 
                            />
                        </div>
                    </div>
                </section>
            
                <section>
                    <h2 class="text-xl font-black mb-2 flex items-center gap-4">
                        Expériences <span class="h-px flex-1 bg-p-gray-blue/20"></span>
                    </h2>
                    <div class="gap-2 grid pb-2">
                        <div class="overflow-hidden">
                            <Card 
                                title="UniCancer" 
                                subtitle="Développement web" 
                                description={`Participation au développement d'un outil de gestion d'étude clinique complète à renommé international : WeShare
                                    - En équipe de 10 personnes avec plusieurs domaines d'expertise
                                    - Discussion et présentation du travail réalisé avec la commanditaire du projet
                                    - Symfony - React - SQL
                                `}
                                uptext="2025" 
                                variant="cv" 
                            />
                        </div>
                        <div class="overflow-hidden">
                            <Card 
                                title="Gustave Roussy" 
                                subtitle="Gestion d'un système d'information" 
                                description={`Administration et développement du système d'information décisionnel de l'entreprise
                                    - Gestion complète d'un projet de traitement de données biogénétiques
                                    - En relation avec les cadres des services concernés
                                    - Entrepôt de données - SQL - Gestion de projet
                                    - Administration
                                `}
                                uptext="2024" 
                                variant="cv" 
                            />
                        </div>
                    </div>
                </section>

                <section>
                    <h2 class="text-xl font-black mb-2 flex items-center gap-4">
                        Projets <span class="h-px flex-1 bg-p-gray-blue/20"></span>
                    </h2>
                    <div class="grid grid-cols-2 gap-2 pb-2">
                        <div class="overflow-hidden">
                            <Card 
                                id="merchventory" 
                                title="Merchventory" 
                                description={`Projet d'étude de 3ème année visant la création d'une plateforme de précommande et de gestion de stocks pour des groupes de musique
                                    - Dockerisation de l'application
                                    - Travail en équipe de 5 étudiants dont un graphiste
                                    - Base de données SQL
                                `}
                                subtitle="Projet d'étude" 
                                uptext="PHP, Symfony, MySQL" 
                                variant="cv"
                            >
                        </div>
                        <div class="overflow-hidden">
                            <Card 
                                id="cryptadvisor" 
                                title="Crypta Dvisor" 
                                description={`Projet d'étude de 4ème année consistant en la création d'une application web FullJS complète de gestion de capital de cryptomonnaies fictives
                                    - CI/CD et Dockerisation complète
                                    - Intégration d'API externes
                                    - Utilisation d'un Gitflow pour l'organisation du travail
                                `}
                                subtitle="Projet d'étude" 
                                uptext="Express.JS, React" 
                                variant="cv" 
                            />
                        </div>
                    </div>
                </section>
            
                
            </main>
        </div>
    </div>
</body>
</html>